<title>Justin Badilla Fernández</title>
<meta name="viewport" content="width=device-width, initial-scale=1" />
<style>
  @import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600;700&family=IBM+Plex+Sans:wght@400;500;600;700&display=swap');

  :root {
    --bg: #f3f4f0;
    --surface: #fbfbf9;
    --surface-alt: #e8ece8;
    --ink: #16212c;
    --ink-soft: #48555f;
    --ink-faint: #7c8890;
    --line: #c7d0d0;
    --line-strong: #9fadad;
    --accent: #0b6e99;
    --accent-strong: #084b6b;
    --accent-soft: #e1eef3;
    --amber: #a3611c;
    --amber-soft: #f3e4d2;
    --green: #3e7d4c;
    --green-soft: #dcece0;
    --shadow: 0 1px 0 rgba(22, 33, 44, 0.06);
    --radius: 3px;
    color-scheme: light;
  }

  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) {
      --bg: #0a2033;
      --surface: #0f2d47;
      --surface-alt: #123651;
      --ink: #eaf4fa;
      --ink-soft: #a9c4d6;
      --ink-faint: #7597ac;
      --line: #1f4a6d;
      --line-strong: #2c6088;
      --accent: #6fcbea;
      --accent-strong: #a4e0f2;
      --accent-soft: #123a57;
      --amber: #e3a34c;
      --amber-soft: #2c2313;
      --green: #7fd39c;
      --green-soft: #12301d;
      --shadow: 0 1px 0 rgba(0, 0, 0, 0.3);
      color-scheme: dark;
    }
  }

  :root[data-theme="dark"] {
    --bg: #0a2033;
    --surface: #0f2d47;
    --surface-alt: #123651;
    --ink: #eaf4fa;
    --ink-soft: #a9c4d6;
    --ink-faint: #7597ac;
    --line: #1f4a6d;
    --line-strong: #2c6088;
    --accent: #6fcbea;
    --accent-strong: #a4e0f2;
    --accent-soft: #123a57;
    --amber: #e3a34c;
    --amber-soft: #2c2313;
    --green: #7fd39c;
    --green-soft: #12301d;
    --shadow: 0 1px 0 rgba(0, 0, 0, 0.3);
    color-scheme: dark;
  }

  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; }

  body {
    margin: 0;
    background: var(--bg);
    color: var(--ink);
    font-family: "IBM Plex Sans", -apple-system, "Segoe UI", sans-serif;
    font-size: 16px;
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
  }

  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
    * { animation-duration: 0.01ms !important; transition-duration: 0.01ms !important; }
  }

  .mono { font-family: "IBM Plex Mono", ui-monospace, "SF Mono", monospace; }

  .wrap {
    max-width: 1080px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .eyebrow {
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  .eyebrow::after {
    content: "";
    flex: 1;
    height: 1px;
    background: var(--line);
  }

  h1, h2, h3 { text-wrap: balance; margin: 0; }

  a { color: inherit; }

  /* header */
  header.site {
    position: sticky;
    top: 0;
    z-index: 20;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(6px);
    border-bottom: 1px solid var(--line);
  }
  header.site .wrap {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 0.85rem;
    padding-bottom: 0.85rem;
  }
  .brand {
    font-family: "IBM Plex Mono", monospace;
    font-weight: 600;
    font-size: 0.95rem;
    letter-spacing: 0.02em;
  }
  .brand span { color: var(--accent); }
  nav.primary {
    display: flex;
    align-items: center;
    gap: 1.4rem;
    flex-wrap: wrap;
  }
  nav.primary a {
    text-decoration: none;
    font-size: 0.85rem;
    color: var(--ink-soft);
    font-family: "IBM Plex Mono", monospace;
    letter-spacing: 0.02em;
    transition: color 0.15s ease;
  }
  nav.primary a:hover { color: var(--accent); }

  .theme-toggle {
    border: 1px solid var(--line-strong);
    background: var(--surface);
    color: var(--ink-soft);
    width: 30px;
    height: 30px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    cursor: pointer;
    flex-shrink: 0;
  }
  .theme-toggle:hover { border-color: var(--accent); color: var(--accent); }
  .theme-toggle svg { width: 15px; height: 15px; }

  /* section shell with drafting corner ticks */
  section { padding: 5rem 0; border-bottom: 1px solid var(--line); }
  section:last-of-type { border-bottom: none; }

  .sheet {
    position: relative;
    border: 1px solid var(--line);
    background: var(--surface);
    box-shadow: var(--shadow);
  }
  .sheet::before, .sheet::after,
  .tick-tl::before, .tick-br::after { content: ""; }
  .corner-ticks { position: relative; }
  .corner-ticks::before, .corner-ticks::after {
    content: "";
    position: absolute;
    width: 10px;
    height: 10px;
    border-top: 1.5px solid var(--accent);
    border-left: 1.5px solid var(--accent);
    top: -1px; left: -1px;
  }
  .corner-ticks::after {
    top: auto; left: auto; bottom: -1px; right: -1px;
    border-top: none; border-left: none;
    border-bottom: 1.5px solid var(--accent);
    border-right: 1.5px solid var(--accent);
  }

  /* hero */
  .hero { padding-top: 3.5rem; }
  .hero-grid {
    display: grid;
    grid-template-columns: 1.35fr 1fr;
    gap: 3rem;
    align-items: start;
  }
  .hero-name {
    font-family: "IBM Plex Mono", monospace;
    font-weight: 600;
    font-size: clamp(2rem, 4.4vw, 3.1rem);
    line-height: 1.08;
    letter-spacing: -0.01em;
    margin: 0.9rem 0 0.4rem;
  }
  .hero-role {
    font-size: 1.05rem;
    color: var(--accent-strong);
    font-weight: 500;
    margin-bottom: 1.3rem;
  }
  .hero-pitch {
    max-width: 56ch;
    color: var(--ink-soft);
    font-size: 1.02rem;
  }
  .chip-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    margin-top: 1.6rem;
  }
  .chip {
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.78rem;
    padding: 0.4rem 0.7rem;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    color: var(--ink-soft);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background: var(--surface);
    transition: border-color 0.15s ease, color 0.15s ease;
  }
  .chip:hover { border-color: var(--accent); color: var(--accent); }

  .cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-top: 1.8rem;
  }
  .btn {
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.85rem;
    letter-spacing: 0.02em;
    text-decoration: none;
    padding: 0.75rem 1.3rem;
    border-radius: var(--radius);
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    border: 1px solid transparent;
    cursor: pointer;
  }
  .btn.primary { background: var(--accent); color: var(--surface); }
  .btn.primary:hover { background: var(--accent-strong); }
  .btn.ghost { border-color: var(--line-strong); color: var(--ink); background: transparent; }
  .btn.ghost:hover { border-color: var(--accent); color: var(--accent); }

  .id-card {
    padding: 1.4rem;
  }
  .id-photo {
    width: 100%;
    aspect-ratio: 3.2 / 4;
    object-fit: cover;
    border: 1px solid var(--line);
    filter: grayscale(0.15) contrast(1.02);
    display: block;
  }
  .id-caption {
    display: flex;
    justify-content: space-between;
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.68rem;
    color: var(--ink-faint);
    letter-spacing: 0.06em;
    margin-top: 0.6rem;
    text-transform: uppercase;
  }
  .stamp {
    margin-top: 1.1rem;
    border-top: 1px dashed var(--line-strong);
    padding-top: 1.1rem;
  }
  .stamp .row {
    display: flex;
    justify-content: space-between;
    gap: 0.6rem;
    font-size: 0.78rem;
    padding: 0.3rem 0;
  }
  .stamp .row + .row { border-top: 1px solid var(--line); }
  .stamp .k { color: var(--ink-faint); font-family: "IBM Plex Mono", monospace; font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.05em; }
  .stamp .v { text-align: right; font-weight: 500; }
  .status-pill {
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.2rem 0.5rem;
    border-radius: 999px;
    background: var(--green-soft);
    color: var(--green);
    white-space: nowrap;
  }

  /* about */
  .about-grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 3rem;
    margin-top: 1.8rem;
    align-items: start;
  }
  .about-grid p { color: var(--ink-soft); margin: 0 0 1rem; max-width: 62ch; }
  .facts {
    border: 1px solid var(--line);
    background: var(--surface);
  }
  .facts .row {
    display: grid;
    grid-template-columns: 40% 60%;
    gap: 0.5rem;
    padding: 0.85rem 1.1rem;
    font-size: 0.88rem;
  }
  .facts .row:not(:last-child) { border-bottom: 1px solid var(--line); }
  .facts .k { font-family: "IBM Plex Mono", monospace; font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--ink-faint); }
  .facts .v { font-weight: 500; }

  /* projects */
  .project-list { display: flex; flex-direction: column; gap: 1.6rem; margin-top: 1.8rem; }
  .project {
    border: 1px solid var(--line);
    background: var(--surface);
    padding: 1.8rem;
  }
  .project-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .project-title { font-size: 1.25rem; font-weight: 600; }
  .project-meta { font-family: "IBM Plex Mono", monospace; font-size: 0.72rem; color: var(--ink-faint); letter-spacing: 0.04em; text-transform: uppercase; margin-top: 0.25rem; }
  .status-tag {
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 0.28rem 0.6rem;
    border-radius: 999px;
    white-space: nowrap;
  }
  .status-tag.live { background: var(--green-soft); color: var(--green); }
  .status-tag.wip { background: var(--amber-soft); color: var(--amber); }
  .project-desc { color: var(--ink-soft); margin: 1rem 0 1.2rem; max-width: 68ch; }
  .stack-row { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1rem; }
  .stack-tag {
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.74rem;
    padding: 0.28rem 0.6rem;
    background: var(--accent-soft);
    color: var(--accent-strong);
    border-radius: var(--radius);
  }
  .feature-row { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1.2rem; }
  .feature-tag {
    font-size: 0.8rem;
    padding: 0.28rem 0.65rem;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    color: var(--ink-soft);
  }
  .project-link {
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.85rem;
    color: var(--accent);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }
  .project-link:hover { color: var(--accent-strong); text-decoration: underline; }
  .project-note { font-size: 0.85rem; color: var(--ink-faint); font-style: italic; }

  /* skills spec sheet */
  .spec-table { margin-top: 1.8rem; border: 1px solid var(--line); background: var(--surface); }
  .spec-row { display: grid; grid-template-columns: 200px 1fr; }
  .spec-row:not(:last-child) { border-bottom: 1px solid var(--line); }
  .spec-label {
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--ink-faint);
    padding: 1rem 1.2rem;
    background: var(--surface-alt);
    border-right: 1px solid var(--line);
    display: flex;
    align-items: center;
  }
  .spec-value { padding: 0.9rem 1.2rem; display: flex; flex-wrap: wrap; gap: 0.5rem; align-items: center; }
  .spec-tag {
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.8rem;
    padding: 0.3rem 0.65rem;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
  }

  /* trajectory */
  .track { margin-top: 1.8rem; display: flex; flex-direction: column; }
  .track-item {
    display: grid;
    grid-template-columns: 110px 1fr;
    gap: 1.2rem;
    padding: 1.4rem 0;
    border-top: 1px solid var(--line);
  }
  .track-year { font-family: "IBM Plex Mono", monospace; font-size: 0.82rem; color: var(--accent); padding-top: 0.15rem; }
  .track-title { font-weight: 600; margin-bottom: 0.3rem; }
  .track-org { font-size: 0.82rem; color: var(--ink-faint); font-family: "IBM Plex Mono", monospace; margin-bottom: 0.5rem; }
  .track-desc { color: var(--ink-soft); font-size: 0.92rem; max-width: 60ch; }

  /* contact */
  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-top: 2rem;
  }
  .contact-card {
    border: 1px solid var(--line);
    background: var(--surface);
    padding: 1.2rem 1.3rem;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    text-decoration: none;
    color: var(--ink);
    transition: border-color 0.15s ease, transform 0.15s ease;
  }
  .contact-card:hover { border-color: var(--accent); transform: translateY(-1px); }
  .contact-k { font-family: "IBM Plex Mono", monospace; font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.06em; color: var(--ink-faint); }
  .contact-v { font-weight: 500; font-size: 0.95rem; word-break: break-word; }
  .copy-hint { font-size: 0.72rem; color: var(--accent); font-family: "IBM Plex Mono", monospace; opacity: 0; transition: opacity 0.15s ease; }
  .contact-card.copied .copy-hint { opacity: 1; }

  footer {
    padding: 2.5rem 0 3.5rem;
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.75rem;
    color: var(--ink-faint);
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  @media (max-width: 800px) {
    .hero-grid, .about-grid, .contact-grid { grid-template-columns: 1fr; }
    .id-card { max-width: 320px; }
    .spec-row { grid-template-columns: 1fr; }
    .spec-label { border-right: none; border-bottom: 1px solid var(--line); }
    .track-item { grid-template-columns: 1fr; }
    section { padding: 3.4rem 0; }
    header.site .wrap { flex-wrap: wrap; row-gap: 0.7rem; }
    header.site .wrap { justify-content: space-between; }
    nav.primary { order: 3; width: 100%; gap: 0.9rem 1.1rem; }
  }
</style>

